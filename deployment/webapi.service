[Unit]
Description=ASP.NET Core Web API
After=network.target

[Service]
WorkingDirectory=/home/ec2-user/webapi-publish
ExecStart=/usr/bin/dotnet /home/ec2-user/webapi-publish/WebApi.dll --urls http://127.0.0.1:5000
Restart=on-failure
RestartSec=5
User=ec2-user
Environment=ASPNETCORE_ENVIRONMENT=Production

[Install]
WantedBy=multi-user.target